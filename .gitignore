# -----------------------------------------------------------
# .gitignore for Cybersecurity Virtual Lab
# Repository: Setting-Up-Your-Own-Lab
# -----------------------------------------------------------

# --- VirtualBox Specifics ---
# Ignore suspended state files (contain RAM dumps)
*.sav
*.vmsn

# Ignore log files generated during runtime
*.log
VBox.log
VBoxHardening.log

# Ignore temporary files
*.tmp
*.tgz

# --- Virtual Disk Images (CRITICAL: These are huge) ---
# Ignore dynamic and fixed disk images
*.vdi
*.vmdk
*.vhd
*.vhdx
*.qcow2

# Ignore disk descriptor files if they contain absolute host paths
# (Keep .vmdk text descriptors if you use them, but ignore the data flats)
*-flat.vmdk

# --- Snapshots ---
# Snapshots contain full state changes and are often large
Snapshots/
*/Snapshots/
*.vbox-prev

# --- OS Specific Artifacts ---

# Kali Linux / Ubuntu / General Linux
*~
.swp
.swo
.DS_Store
Thumbs.db
.cache/
.trash/
*.bak

# Android-x86 / Genymotion
android-data/
data.img
userdata.qcow2
cache.qcow2
adbkey
adbkey.pub

# --- Sensitive Data & Credentials ---
# Never commit SSH keys or password files
id_rsa
id_rsa.pub
authorized_keys
*.pem
*.key
.secrets
credentials.json
access_keys.json
config.ini
*.conf.local

# --- Network Configuration (Host-Specific) ---
# VirtualBox Host-Only network UUIDs change per host
VirtualBox.xml
network-config-host-only.conf

# --- Build & Compilation ---
# If you compile custom kernels or tools
*.o
*.ko
bin/
obj/
__pycache__/
*.pyc

# --- Documentation Build ---
# If you generate PDFs or HTML from markdown
docs/_build/
*.pdf

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Keep these files (Examples) ---
# Uncomment if you accidentally ignored them above
# !README.md
# !setup.sh
# !docs/   
